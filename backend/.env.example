# Database Configuration
MONGODB_URI=mongodb://localhost:27017/meet-clone

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# Server Configuration
PORT=8080
ENV=development
CORS_ORIGIN=http://localhost:3000

# Cloudflare RealtimeKit Configuration
# Get these from: https://dash.cloudflare.com/?to=/:account/realtime/kit
# Account ID: Found in Cloudflare Dashboard URL or Account Settings
# API Token: Create at https://dash.cloudflare.com/profile/api-tokens with "Realtime Admin" permission
# App ID: Create a RealtimeKit app in dashboard to get this
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_APP_ID=